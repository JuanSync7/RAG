# Prod environment values for the docker-compose.prod.yml overlay (--env-file).
# Non-secret: host-port values + project name + the rootless podman socket.
# Used by scripts/prod-up.sh. Ports match the current prod exposure so the
# cutover is a like-for-like replacement (the current lean stack is torn down
# first). Secrets (Langfuse keys, Grafana admin, etc.) come from the main .env.

COMPOSE_PROJECT_NAME=ragweave-prod

# --- Host ports (match current prod) ---
RAG_API_HOST_PORT=8000
RAG_WEAVIATE_HTTP_HOST_PORT=8079
RAG_WEAVIATE_GRPC_HOST_PORT=50051
RAG_REDIS_PORT=6379
RAG_MINIO_PORT=9000
RAG_MINIO_CONSOLE_PORT=9001
RAG_TEMPORAL_PORT=7233
RAG_TEMPORAL_UI_PORT=8088
RAG_NGINX_HTTP_PORT=8080
RAG_NGINX_HTTPS_PORT=8443
LANGFUSE_PORT=3000
LANGFUSE_MINIO_HOST_PORT=9090
PROMETHEUS_HOST_PORT=9091
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3001
DOZZLE_HOST_PORT=9999

# Rootless podman socket (dozzle container control).
CONTAINER_SOCK=/run/user/5153928/podman/podman.sock
