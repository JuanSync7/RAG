# Dev environment values for the docker-compose.dev.yml overlay (--env-file).
# Non-secret: host-port remaps + project name + the rootless podman socket.
# Used by scripts/dev-up.sh. Secrets (Langfuse keys, etc.) come from the main
# .env if needed; dev defaults are fine without them.

COMPOSE_PROJECT_NAME=ragweave-dev

# --- Host port remaps (all distinct from prod; base publishes ${VAR}:internal) -
RAG_API_HOST_PORT=8102
RAG_WEAVIATE_HTTP_HOST_PORT=8190
RAG_WEAVIATE_GRPC_HOST_PORT=50152
RAG_REDIS_PORT=6380
RAG_MINIO_PORT=9010
RAG_MINIO_CONSOLE_PORT=9011
RAG_TEMPORAL_PORT=7234
RAG_TEMPORAL_UI_PORT=8234
LANGFUSE_PORT=3010
LANGFUSE_MINIO_HOST_PORT=9012
PROMETHEUS_HOST_PORT=9092
ALERTMANAGER_HOST_PORT=9094
GRAFANA_HOST_PORT=3011
DOZZLE_HOST_PORT=9998

# Rootless podman socket (dozzle container control).
CONTAINER_SOCK=/run/user/5153928/podman/podman.sock
