# ============================================================
# Service Ports — single source of truth for all port numbers.
# Change a port here and every reference picks it up.
# ============================================================
RAG_API_PORT=8000
RAG_API_HOST_PORT=8000
RAG_OLLAMA_PORT=11434
RAG_REDIS_PORT=6379
RAG_TEMPORAL_PORT=7233
RAG_TEMPORAL_UI_PORT=8080
LANGFUSE_PORT=3000
GRAFANA_HOST_PORT=3001
PROMETHEUS_HOST_PORT=9091
ALERTMANAGER_HOST_PORT=9093
DOZZLE_HOST_PORT=9999
RAG_NGINX_HTTP_PORT=80
RAG_NGINX_HTTPS_PORT=443

# --- MinIO (artifact storage, always-on) ---
# Host-side ports for the rag-minio container. 9000 = S3 API, 9001 = web console.
RAG_MINIO_PORT=9000
RAG_MINIO_CONSOLE_PORT=9001
# Root credentials — compose default is minioadmin/minioadmin.
# CHANGE BEFORE ANY NON-LOCAL DEPLOYMENT (uncomment + set new values):
# RAG_MINIO_ACCESS_KEY=
# RAG_MINIO_SECRET_KEY=

# --- Weaviate (vector store, always-on) ---
# "embedded"  = in-process Weaviate inside the venv (CI/test path; requires the
#               `weaviate-embedded` extra). No container needed.
# "networked" = connect to the rag-weaviate container. This is the right choice
#               for both fully-containerised mode AND venv dev against
#               `make start`. Containerised rag-api/rag-worker override this to
#               `networked` regardless of what's set here.
RAG_WEAVIATE_MODE=networked
# For venv dev → localhost (rag-weaviate publishes 8090/50051 on the host).
# For in-cluster clients, compose overrides to host=rag-weaviate, port=8080.
RAG_WEAVIATE_HOST=localhost
RAG_WEAVIATE_HTTP_PORT=8090
RAG_WEAVIATE_GRPC_PORT=50051
# Host-side port bindings for the rag-weaviate container (host 8080 is taken by temporal-ui).
RAG_WEAVIATE_HTTP_HOST_PORT=8090
RAG_WEAVIATE_GRPC_HOST_PORT=50051
# Default per-query result limit (Weaviate `QUERY_DEFAULTS_LIMIT`).
RAG_WEAVIATE_QUERY_LIMIT=25
# SECURITY: anonymous access is on by default for local dev. Disable + configure
# API key auth for any non-local deployment. Example hardened config:
#   RAG_WEAVIATE_ANON_ACCESS=false
#   RAG_WEAVIATE_APIKEY_ENABLED=true
#   RAG_WEAVIATE_APIKEY_ALLOWED=secret-key-1,secret-key-2
#   RAG_WEAVIATE_APIKEY_USERS=admin@example.com,reader@example.com
#   RAG_WEAVIATE_ADMIN_ENABLED=true
#   RAG_WEAVIATE_ADMIN_USERS=admin@example.com
RAG_WEAVIATE_ANON_ACCESS=true
RAG_WEAVIATE_APIKEY_ENABLED=false
RAG_WEAVIATE_APIKEY_ALLOWED=
RAG_WEAVIATE_APIKEY_USERS=
RAG_WEAVIATE_ADMIN_ENABLED=false
RAG_WEAVIATE_ADMIN_USERS=

# --- Postgres (rag-postgres — application metadata, LiteLLM spend logs) ---
# Compose defaults: litellm / litellm / litellm.
# CHANGE BEFORE ANY NON-LOCAL DEPLOYMENT (uncomment + set new values):
# RAG_POSTGRES_USER=
# RAG_POSTGRES_PASSWORD=
# RAG_POSTGRES_DB=

# --- Postgres (temporal-db — Temporal server backing store) ---
# Only consumed by the temporal-server container; not exposed to the host.
# Compose defaults: temporal / temporal / temporal. Override only if needed:
# TEMPORAL_POSTGRES_USER=
# TEMPORAL_POSTGRES_PASSWORD=
# TEMPORAL_POSTGRES_DB=

# --- Redis (rag-redis) ---
# Leave empty for no auth (default; preserves prior behavior).
# Set a value to enforce password auth — when set, you MUST update the URLs
# below to include the password: redis://:YOUR_PASSWORD@localhost:6379/0
RAG_REDIS_AUTH=

# --- Derived URLs (built from ports above) ---
RAG_API_URL=http://localhost:${RAG_API_PORT}
RAG_OLLAMA_URL=http://localhost:${RAG_OLLAMA_PORT}
RAG_LLM_API_BASE=http://localhost:${RAG_OLLAMA_PORT}
# When RAG_REDIS_AUTH is set, change to: redis://:${RAG_REDIS_AUTH}@localhost:${RAG_REDIS_PORT}/0
RAG_CACHE_REDIS_URL=redis://localhost:${RAG_REDIS_PORT}/0
RAG_MEMORY_REDIS_URL=redis://localhost:${RAG_REDIS_PORT}/0

# --- Server ---
RAG_API_MAX_INFLIGHT_REQUESTS=64
RAG_API_OVERLOAD_QUEUE_TIMEOUT_MS=250

# --- Observability (Langfuse — only used when --profile observability is active) ---
RAG_OBSERVABILITY_PROVIDER=otel
LANGFUSE_HOST=http://localhost:${LANGFUSE_PORT}
# Get these from the Langfuse UI → Settings → API Keys after first login.
LANGFUSE_PUBLIC_KEY=pk_replace_me
LANGFUSE_SECRET_KEY=sk_replace_me
# NextAuth secrets — must be 64-char hex; generate with `openssl rand -hex 32`.
LANGFUSE_NEXTAUTH_URL=http://localhost:${LANGFUSE_PORT}
LANGFUSE_NEXTAUTH_SECRET=replace_me
LANGFUSE_SALT=replace_me
LANGFUSE_ENCRYPTION_KEY=replace_me
LANGFUSE_TELEMETRY_ENABLED=false

# --- OpenTelemetry exporter (used by the OTel observability backend) ---
# Targets Langfuse's OTLP/HTTP ingest endpoint by default.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:${LANGFUSE_PORT}/api/public/otel
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=ragweave
# Auth: Langfuse OTLP accepts HTTP Basic with public:secret. The OTel
# exporter passes this as an Authorization header via OTEL_EXPORTER_OTLP_HEADERS.
# This value is constructed at runtime by the backend from
# LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY — do not hardcode here.

# Backing-store credentials for the Langfuse stack. Compose defaults are the
# upstream Langfuse reference values (postgres/postgres, clickhouse/clickhouse,
# minio/miniosecret, redis password "myredissecret"). They work for local dev;
# rotate before any non-local deployment by uncommenting + setting:
# LANGFUSE_POSTGRES_USER=
# LANGFUSE_POSTGRES_PASSWORD=
# LANGFUSE_POSTGRES_DB=
# LANGFUSE_CLICKHOUSE_USER=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_REDIS_AUTH=
# LANGFUSE_MINIO_USER=
# LANGFUSE_MINIO_PASSWORD=
# Host-side port for langfuse-minio (separate from the main rag-minio above).
LANGFUSE_MINIO_HOST_PORT=9090

# Optional: auto-create an initial Langfuse org/user on first boot.
# LANGFUSE_INIT_ORG_NAME=ragweave
# LANGFUSE_INIT_PROJECT_NAME=default
# LANGFUSE_INIT_USER_NAME=admin
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_PASSWORD=replace_me

# --- Grafana (only used when --profile monitoring is active) ---
# Compose defaults: admin / admin. CHANGE BEFORE EXPOSING:
# GRAFANA_ADMIN_USER=
# GRAFANA_ADMIN_PASSWORD=

# --- Auth ---
RAG_AUTH_API_KEYS_REQUIRED=false
RAG_AUTH_API_KEYS_JSON={}
RAG_AUTH_JWT_ENABLED=false
RAG_AUTH_JWT_HS256_SECRET=replace_me
RAG_AUTH_OIDC_ENABLED=false
RAG_AUTH_OIDC_ISSUER=https://issuer.example.com/
RAG_AUTH_OIDC_AUDIENCE=rag-api
RAG_AUTH_OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
RAG_AUTH_OIDC_ROLES_CLAIM=roles
RAG_AUTH_OIDC_TENANT_CLAIM=tenant_id
RAG_AUTH_OIDC_SUBJECT_CLAIM=sub
RAG_DEFAULT_TENANT_ID=default
RAG_AUTH_API_KEYS_STORE_PATH=.runtime/security/api_keys.json
RAG_AUTH_QUOTAS_STORE_PATH=.runtime/security/quotas.json

# --- Rate limiting ---
RAG_RATE_LIMIT_ENABLED=true
RAG_RATE_LIMIT_REQUESTS_PER_MINUTE=60
RAG_RATE_LIMIT_WINDOW_SECONDS=60

# --- Database retention / cleanup ---
# How long Temporal keeps completed workflow histories before auto-deleting them.
# Format: Go duration string. 720h = 30 days. Default in Temporal is 72h (3 days).
TEMPORAL_WORKFLOW_RETENTION=720h
# How many days of LiteLLM spend logs to keep. Older rows are deleted nightly.
LITELLM_LOG_RETENTION_DAYS=90

# --- Cache ---
RAG_CACHE_ENABLED=true
RAG_CACHE_PROVIDER=redis
RAG_CACHE_TTL_SECONDS=120

# --- Conversation memory ---
RAG_MEMORY_ENABLED=true
RAG_MEMORY_PROVIDER=redis
RAG_MEMORY_REDIS_PREFIX=rag:memory
RAG_MEMORY_MAX_RECENT_TURNS=8
RAG_MEMORY_MAX_CONTEXT_TOKENS_ESTIMATE=1400
RAG_MEMORY_SUMMARY_TRIGGER_TURNS=12
RAG_MEMORY_SUMMARY_MAX_SOURCE_TURNS=40

# --- Retrieval ---
RAG_DEFAULT_FAST_PATH=false
RAG_RETRIEVAL_TIMEOUT_MS=30000
RAG_STAGE_BUDGET_QUERY_PROCESSING_MS=12000
RAG_STAGE_BUDGET_KG_EXPANSION_MS=1000
RAG_STAGE_BUDGET_EMBEDDING_MS=1500
RAG_STAGE_BUDGET_HYBRID_SEARCH_MS=5000
RAG_STAGE_BUDGET_RERANKING_MS=5000
RAG_STAGE_BUDGET_GENERATION_MS=60000

# --- Local ML Models ---
# Only used when RAG_INFERENCE_BACKEND=local AND you want to load from a
# specific on-disk path. The `local` backend requires the `local-embed`
# pyproject extra in your venv (`uv sync --extra local-embed`). By default the
# local path resolves model names by HuggingFace repo ID via the HF cache
# (~/.cache/huggingface/) — no explicit RAG_MODEL_ROOT is needed. Set this only
# if you want to pin to a directory of pre-downloaded weights.
#
# RAG_MODEL_ROOT=./models

# --- LLM ---
# To use OpenRouter instead of Ollama:
#   RAG_LLM_MODEL=openrouter/anthropic/claude-3-haiku
#   RAG_LLM_API_BASE=https://openrouter.ai/api/v1
#   RAG_LLM_API_KEY=sk-or-v1-...
RAG_LLM_MODEL=ollama/qwen2.5:3b
RAG_LLM_API_KEY=
RAG_LLM_FALLBACK_MODELS=
RAG_LLM_VISION_MODEL=ollama/qwen2.5vl:3b
RAG_LLM_QUERY_MODEL=
RAG_LLM_MAX_TOKENS=1024
RAG_LLM_TEMPERATURE=0.3
RAG_LLM_NUM_RETRIES=3
RAG_LLM_ROUTER_CONFIG=

# --- Knowledge Graph (Neo4j backend, optional) ---
# Consumed by KGConfig defaults in src/knowledge_graph/common/types.py.
# Override per-deployment; defaults are dev-friendly.
RAG_KG_NEO4J_URI=bolt://localhost:7687
RAG_KG_NEO4J_AUTH_USER=neo4j
RAG_KG_NEO4J_AUTH_PASSWORD=
RAG_KG_NEO4J_DATABASE=neo4j

# --- Ingestion ---
RAG_INGESTION_LLM_ENABLED=true
RAG_INGESTION_LLM_MODEL=qwen2.5:3b
RAG_INGESTION_LLM_TEMPERATURE=0.1
RAG_INGESTION_LLM_TIMEOUT_SECONDS=45
RAG_INGESTION_LLM_MAX_KEYWORDS=12
RAG_INGESTION_DOCLING_ENABLED=true
RAG_INGESTION_DOCLING_MODEL=docling-parse-v2
RAG_INGESTION_DOCLING_ARTIFACTS_PATH=
RAG_INGESTION_DOCLING_STRICT=true
RAG_INGESTION_DOCLING_AUTO_DOWNLOAD=true
RAG_INGESTION_EXPORT_EXTENSIONS=.txt,.md,.markdown,.rst,.html,.htm,.pdf,.docx,.pptx
RAG_INGESTION_ENABLE_MULTIMODAL_PROCESSING=false
RAG_INGESTION_VISION_ENABLED=false
RAG_INGESTION_VISION_PROVIDER=ollama
RAG_INGESTION_VISION_MODEL=qwen2.5vl:3b
RAG_INGESTION_VISION_TIMEOUT_SECONDS=60
RAG_INGESTION_VISION_MAX_FIGURES=4
RAG_INGESTION_VISION_MAX_IMAGE_BYTES=3145728
RAG_INGESTION_VISION_TEMPERATURE=0.1
RAG_INGESTION_VISION_MAX_TOKENS=220
RAG_INGESTION_VISION_AUTO_PULL=true
RAG_INGESTION_VISION_STRICT=false
RAG_INGESTION_VISION_API_BASE_URL=
RAG_INGESTION_VISION_API_KEY=
RAG_INGESTION_VISION_API_PATH=/v1/chat/completions

# ============================================================
# Container Runtime (Podman)
# Uncomment the line below if using Podman instead of Docker.
# This tells Dozzle (container log viewer) where to find the
# container socket. Docker users can ignore this.
# ============================================================
# CONTAINER_SOCK=$XDG_RUNTIME_DIR/podman/podman.sock

RAG_INGESTION_ENABLE_DOCUMENT_REFACTORING=false
RAG_INGESTION_ENABLE_CROSS_REFERENCE_EXTRACTION=true
RAG_INGESTION_ENABLE_KNOWLEDGE_GRAPH_EXTRACTION=true
RAG_INGESTION_ENABLE_QUALITY_VALIDATION=true
RAG_INGESTION_ENABLE_KNOWLEDGE_GRAPH_STORAGE=true
RAG_INGESTION_VERBOSE_STAGE_LOGS=false
RAG_INGESTION_PERSIST_REFACTOR_MIRROR=true

# --- Inference Backend (embed + rerank) ---
# "local" = BGE models run in-process inside your venv (dev path). Requires the
#           `local-embed` pyproject extra: `uv sync --extra local-embed`. The
#           containerized rag-worker image does NOT ship torch — setting this
#           inside a container will fail with ImportError.
# "tei"   = BGE models served by separate TEI containers (rag-embed / rag-rerank)
#           over HTTP. Both containers are part of the always-on compose stack.
#
# To switch to TEI for dev:
#   ./scripts/compose.sh up -d rag-embed rag-rerank rag-nginx
#   # then: export RAG_INFERENCE_BACKEND=tei RAG_TEI_EMBED_URL=http://localhost:8081 ...
RAG_INFERENCE_BACKEND=local

# HuggingFace token — required only for gated/private models. BGE-M3 and
# BGE-reranker-v2-m3 are both public, so TEI works without this token set.
HUGGING_FACE_HUB_TOKEN=

# TEI service URLs (used when RAG_INFERENCE_BACKEND=tei).
# rag-nginx fronts both services on 8081 (embed) / 8082 (rerank) so replicas
# can be scaled with `docker compose up -d --scale rag-embed=N`.
# Inside compose: rag-nginx:8081 / :8082. From the host: localhost:8081 / :8082.
RAG_TEI_EMBED_URL=http://rag-nginx:8081
RAG_TEI_RERANK_URL=http://rag-nginx:8082

# Host-side port bindings for the nginx TEI lanes.
RAG_TEI_EMBED_HOST_PORT=8081
RAG_TEI_RERANK_HOST_PORT=8082

# Models loaded by the TEI containers (HuggingFace repo IDs).
RAG_TEI_EMBEDDING_MODEL=BAAI/bge-m3
RAG_TEI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# TEI image tag — pick by GPU arch. scripts/check_env.sh auto-detects this.
# turing-1.5 = SM 7.5 (RTX 20xx, T4); 86-1.5 = SM 8.0/8.6 (A10, 30xx);
# 89-1.5 = SM 8.9 (40xx, L4); latest = SM 9.0 (H100); cpu-1.5 = no GPU.
RAG_TEI_IMAGE_TAG=turing-1.5
# Reranker image tag — defaults to CPU (`turing-1.8`) because rag-rerank shares a
# 6 GB GPU with rag-embed + Ollama in the reference config. Switch to a GPU tag
# (e.g. `89-1.8`) on cards with ≥12 GB VRAM.
RAG_TEI_RERANK_IMAGE_TAG=turing-1.8

# HTTP timeout for embed/rerank calls. Must exceed first-call warmup.
RAG_TEI_TIMEOUT_SECONDS=30

# TEI batch / concurrency tuning. Defaults are sized for a 6 GB RTX 2060 sharing
# the GPU with Ollama. Raise on dedicated GPUs to improve throughput; lower if
# you see OOM during warmup. CPU pool is independently tuned because it has no
# VRAM constraint but is bound by host RAM and CPU cores.
RAG_TEI_EMBED_MAX_BATCH_TOKENS=2048
RAG_TEI_EMBED_MAX_CONCURRENT=8
RAG_TEI_EMBED_CPU_MAX_BATCH_TOKENS=1024
RAG_TEI_EMBED_CPU_MAX_CONCURRENT=4
RAG_TEI_RERANK_MAX_BATCH_TOKENS=2048
RAG_TEI_RERANK_MAX_CONCURRENT=4

# --- Ollama tuning ---
# How long to keep loaded models resident in VRAM after the last request.
# "5m" balances cold-start latency vs. freeing GPU. "0" = unload immediately;
# "-1" = keep forever (good for single-tenant boxes).
OLLAMA_KEEP_ALIVE=5m

# --- Generation gate ---
# Minimum composite confidence before the answer is returned to the user.
# 0.0 = always return; raise to make low-confidence answers route to FLAG/BLOCK.
RAG_QUERY_CONFIDENCE_THRESHOLD=0.0

# --- Gateway (nginx HTTPS) ---
# When using the gateway profile, rag-api port 8000 remains directly accessible.
# For LAN demos or hardened deployments, bind rag-api to loopback only:
# RAG_API_HOST_PORT=127.0.0.1:8000

# --- Console source document viewer ---
# Colon-separated list of host directories the console may read source docs from.
# The rag-api container must also have these mounted at the same absolute paths
# (see the volumes block in docker-compose.yml).
# Default covers docs/ and documents/ which are mounted automatically.
# Add extra dirs here if you ingest from other locations:
# RAG_CONSOLE_SOURCE_ROOTS=${PWD}/documents:${PWD}/docs:/path/to/other/dir

# --- Container image tags ---
# App images are published to GHCR by .github/workflows/publish-images.yml.
# CI publishes `:latest` (and pinned SHAs) — those track main.
#
# For local development we use a separate `:dev` tag so your local builds
# can never be clobbered by `docker compose pull` or a CI-published `:latest`.
# `make container-build` tags images as `:dev` by default; set the same tag
# here so `docker compose up` reads your local build.
#
# Override the registry path with RAG_{API,WORKER}_IMAGE_REF if you publish
# to a different org. Pin to a SHA or version for reproducibility.
#
# DEFAULT (fresh clone, no local build): leave commented → compose pulls
# `:latest` from GHCR, which is what CI publishes from main.
#
# LOCAL DEV (you run `make container-build`): uncomment the two `:dev`
# lines below so compose reads the same tag the Makefile writes.
# RAG_API_IMAGE_TAG=dev
# RAG_WORKER_IMAGE_TAG=dev
# RAG_API_IMAGE_REF=ghcr.io/juansync7/ragweave-api
# RAG_WORKER_IMAGE_REF=ghcr.io/juansync7/ragweave-worker

# Pinned versions for high-churn third-party images. Override only when you
# know the new version is compatible (Temporal in particular has breaking
# workflow-task-queue changes between minor releases).
# TEMPORAL_IMAGE_TAG=1.25.2
# TEMPORAL_UI_IMAGE_TAG=2.31.2
# RAG_MINIO_IMAGE_TAG=RELEASE.2025-04-22T22-12-26Z
